# =============================================================================
# WhatsApp Bot — Environment Configuration
# =============================================================================
#
# ARCHITECTURE:
#   .env          → Bot-only secrets (this file). NOT shared with Docker.
#   evolution.env → Evolution API secrets. Used by docker-compose.yml.
#
# PRODUCTION DEPLOYMENT:
#   The deploy script (scripts/deploy.sh) auto-generates both files with
#   fresh secrets. See deploy/README.md for full instructions.
#
#   Key production differences:
#     - BOT_FT_REDIRECT_URI must use HTTPS (e.g. https://wab.nix.zone/oauth/callback)
#     - BOT_SCRAPER_ENABLED=true
#     - All secrets are freshly generated (never reuse dev secrets)
#     - File permissions must be 0600
#
# =============================================================================
# Bot Service
# =============================================================================
BOT_EVOLUTION_API_URL=http://localhost:18080
BOT_EVOLUTION_API_KEY=          # REQUIRED: same as AUTHENTICATION_API_KEY in evolution.env
BOT_WEBHOOK_HOST=0.0.0.0
BOT_WEBHOOK_PORT=8000
BOT_INSTANCE_NAME=default

# =============================================================================
# 42 API (Intra)
# =============================================================================
BOT_FT_CLIENT_ID=                # 42 OAuth app client ID
BOT_FT_CLIENT_SECRET=            # 42 OAuth app client secret
BOT_FT_CAMPUS_ID=1               # Campus ID (1 = Paris)
BOT_FT_REDIRECT_URI=http://localhost:8000/oauth/callback  # Use HTTPS in production!
BOT_USER_TOKENS_PATH=data/user_tokens.json   # Persistent user token store
BOT_BUTTON_EVENTS_PATH=data/button_events.json  # Button→event ID mapping
BOT_ADMIN_WHATSAPP_NUMBER=       # Only this number may manage /filter commands
BOT_SCRAPER_ENABLED=false        # Enable periodic event scraping
BOT_SCRAPER_INTERVAL_SECONDS=300 # Poll interval in seconds
BOT_WHATSAPP_GROUP_JID=          # Target group JID e.g. 120363XXX@g.us
BOT_SEEN_EVENTS_PATH=data/seen_events.json
BOT_OFFERS_SCRAPER_ENABLED=false          # Enable periodic offers scraping
BOT_OFFERS_SCRAPER_INTERVAL_SECONDS=600   # Poll interval for offers (seconds)
BOT_SEEN_OFFERS_PATH=data/seen_offers.json

# =============================================================================
# Gemini API (event summarization)
# =============================================================================
BOT_GEMINI_API_KEY=              # Google AI Studio API key (optional, falls back to truncation)

# =============================================================================
# Security
# =============================================================================
# Webhook authentication — shared secret token appended to webhook URL.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Must match the ?token= param in evolution.env WEBHOOK_GLOBAL_URL
BOT_WEBHOOK_SECRET=

# Token encryption — Fernet key for encrypting user OAuth tokens at rest.
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Existing plaintext tokens are auto-migrated on first write after setting this.
BOT_TOKEN_ENCRYPTION_KEY=
